# 通用 Go 微服务镜像:多阶段构建,纯 Go(SQLite 免 CGO)
# build: docker build -f deploy/Dockerfile.svc --build-arg SVC=app/user/rpc -t gdm-user-rpc .
FROM golang:1.26-alpine AS builder
ARG SVC=app/user/rpc
ARG GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0 GOOS=linux
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg ./pkg
COPY app ./app
RUN go build -trimpath -ldflags="-s -w" -o /out/server ./${SVC}

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 app
WORKDIR /app
ARG SVC
COPY --from=builder /out/server ./server
COPY --from=builder /src/${SVC}/etc ./etc
RUN mkdir -p /app/data /app/log && chown -R app /app
USER app
ENTRYPOINT ["./server"]
